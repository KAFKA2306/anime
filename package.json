{
  "name": "kafka2306-anime",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Canonical d Anime Store catalogue and cache-first auditable ontology pipeline",
  "scripts": {
    "acquire:raw": "node scripts/acquire-danime.mjs",
    "attributes:rebuild-cache": "node scripts/rebuild-attributes-from-cache.mjs",
    "attributes:apply": "node scripts/apply-attributes.mjs",
    "attributes:enrich": "node scripts/enrich-official-details.mjs && npm run attributes:apply",
    "attributes:verify": "node scripts/verify-attribute-coverage.mjs",
    "acquire": "node scripts/acquire-danime.mjs && node scripts/stabilize-generated-data.mjs && npm run attributes:apply",
    "api:build": "node scripts/build-catalog-api.mjs",
    "api:verify": "node --test tests/catalog-api.test.mjs && npm run api:build",
    "validate": "node scripts/validate-data.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "playwright": "1.61.1"
  },
  "engines": {
    "node": ">=22"
  }
}
